{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "d836319002ec4f74a4b142447646a27b",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "VertexSnap (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -377.0,
            "y": -0.000029921531677246094,
            "width": 220.0,
            "height": 118.00003051757813
        }
    },
    "m_Slots": [
        {
            "m_Id": "0a376a57a28d4468b62decf45697058a"
        },
        {
            "m_Id": "4d59c6d7bbf642cd87d7d29c804e5175"
        },
        {
            "m_Id": "bef0023579d04b1da3887a13b95ff0c1"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "VertexSnap",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float4 positionWS = mul(unity_ObjectToWorld, float4(PositionOS, 1.0));\r\nfloat4 positionCS = mul(UNITY_MATRIX_VP, positionWS);\r\n\r\nfloat4 snappedCS = positionCS;\r\nsnappedCS.xyz = positionCS.xyz / positionCS.w;\r\nsnappedCS.xy  = floor(snappedCS.xy * GridSize) / GridSize;\r\nsnappedCS.xyz *= positionCS.w;\r\n\r\nfloat4 snappedWS = mul(UNITY_MATRIX_I_VP, snappedCS);\r\nfloat4 snappedOS = mul(unity_WorldToObject, snappedWS);\r\n\r\nOut = snappedOS.xyz;"
}

